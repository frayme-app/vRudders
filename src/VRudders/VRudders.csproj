<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/vrudders.ico</ApplicationIcon>
    <Version>0.2.0-beta.4</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>VRudders — Rudder Control</Product>
    <Description>Rudder pedals to virtual yaw for Windows games</Description>
    <Company>Ermis Catevatis</Company>
    <Copyright>Copyright © 2026 Ermis Catevatis</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/vrudders.ico" LogicalName="VRudders.Assets.AppIcon" />
    <EmbeddedResource Include="Assets/helicopter-header.png" LogicalName="VRudders.Assets.Helicopter" />
  </ItemGroup>
</Project>
